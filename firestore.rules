rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'name', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.name is string && data.name.size() <= 100 &&
        data.role in ['user', 'admin'] &&
        data.createdAt is string;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'description', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('status' in data) || data.status in ['draft', 'published', 'archived']) &&
        data.createdAt is string;
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == userId &&
        incoming().email == request.auth.token.email &&
        incoming().role == 'user';
        
      allow update: if isValidId(userId) &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            isValidUser(incoming()) &&
            incoming().uid == existing().uid &&
            incoming().email == existing().email &&
            incoming().role == existing().role
          )
        );
        
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().id == projectId &&
        incoming().ownerId == request.auth.uid;
        
      allow update: if isValidId(projectId) &&
        (
          isAdmin() ||
          (
            isOwner(existing().ownerId) &&
            isValidProject(incoming()) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId
          )
        );
        
      allow delete: if isValidId(projectId) && (isOwner(existing().ownerId) || isAdmin());
    }
  }
}
